{{#if listado.length}}
    {{#each listado}}
    <a href="" class="card group block bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer no-underline"
        data-product-id="{{id}}"
        onclick="agregarCarrito(event,'{{id}}',this)" data-tilt data-tilt-max="5" data-tilt-speed="400" data-tilt-glare data-tilt-max-glare="0.1">
        <article>
            <!-- Product image -->
            <div class="card__image relative" style="background-image: url('{{foto}}');">
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-all duration-300"></div>
                {{#if envio}}
                <span class="absolute top-3 left-3 bg-emerald-500 text-white text-xs font-semibold px-2.5 py-1 rounded-full">
                    Envío gratis
                </span>
                {{/if}}
                <!-- Favorite heart button -->
                <button class="btn-favorito absolute top-3 right-3 w-8 h-8 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-white transition-all shadow-sm"
                    onclick="toggleFavorito(event,'{{id}}')" data-id="{{id}}" aria-label="Favorito">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" class="fav-icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                </button>
            </div>

            <!-- Product info -->
            <div class="p-5">
                <p class="text-gray-400 text-xs font-medium uppercase tracking-wider mb-1">{{marca}}</p>
                <h3 class="font-semibold text-gray-900 text-sm mb-1 line-clamp-2 leading-snug">{{nombre}}</h3>
                <p class="text-gray-400 text-xs mb-4 line-clamp-2">{{detalles}}</p>

                <div class="flex items-center justify-between gap-2">
                    <div>
                        <p class="text-gray-900 font-bold text-lg leading-none">$ {{precio}}</p>
                        <p class="text-gray-400 text-xs mt-0.5">12 cuotas sin interés</p>
                    </div>
                    <button
                        class="flex items-center gap-1.5 bg-gray-900 group-hover:bg-gray-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-colors duration-200"
                        onclick="agregarCarrito(event,'{{id}}',this)">
                        <span class="icon-cart text-sm"></span>
                        Agregar
                    </button>
                </div>
            </div>
        </article>
    </a>
    {{/each}}
{{else}}
    <div class="col-span-full flex flex-col items-center justify-center py-20 text-center">
        <div class="w-16 h-16 bg-gray-100 rounded-2xl flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#9ca3af" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"/>
            </svg>
        </div>
        <p class="text-gray-400 font-medium">No se encontraron productos</p>
        <p class="text-gray-400 text-sm mt-1">Agregá productos desde el panel de Alta</p>
    </div>
{{/if}}

# Puerto donde corre la app (Hostinger asigna el suyo via variable de entorno)
PORT=9000

# Tipo de persistencia: MONGODB | MEM | FILE
TIPO=MONGODB

# Cadena de conexión MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# Token de acceso de Mercado Pago (Panel de desarrolladores → Credenciales de producción)
MP_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL base de callback post-pago (en producción: tu dominio real)
CALLBACK_URL=https://tudominio.com/api/carrito/feedback
